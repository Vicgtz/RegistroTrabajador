@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Iniciar sesión - Registro de Trabajo</PageTitle>

<div class="card login-card border-0">
    <div class="card-body p-4">
        <div class="login-marca"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6a1 1 0 0 1 1 1v2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3V5a1 1 0 0 1 1-1Zm1 3h4V6h-4v1Z" /></svg></div>
        <h1 class="h4 text-center mb-1">Registro de Trabajo</h1>
        <p class="text-center text-muted mb-4">Inicia sesión para continuar</p>

        <EditForm Model="modelo" OnValidSubmit="IniciarSesion">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="correo" class="form-label">Correo</label>
                <InputText id="correo" type="email" class="form-control" @bind-Value="modelo.Correo" autocomplete="username" disabled="@cargando" />
                <ValidationMessage For="() => modelo.Correo" />
            </div>

            <div class="mb-3">
                <label for="contra" class="form-label">Contraseña</label>
                <CampoContrasena id="contra" class="form-control" @bind-Value="modelo.Contrasena" autocomplete="current-password" disabled="@cargando" />
                <ValidationMessage For="() => modelo.Contrasena" />
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger py-2" role="alert">@error</div>
            }

            <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Iniciar sesión</span>
                }
            </button>
            <div class="text-center mt-3"><a href="olvide-contrasena">¿Olvidaste tu contraseña?</a></div>
            <div class="text-center mt-2"><a href="registro">Crear cuenta con clave de registro</a></div>
        </EditForm>
    </div>
</div>
