@page "/buscar-perfil"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject ExpedienteClient Api

<PageTitle>Buscar por perfil - Registro de Trabajo</PageTitle>

<SoloConPermiso Codigo="@Permisos.ExpedienteBuscar">
    <h1 class="h3 mb-3">Buscar por perfil profesional</h1>

    @if (Puede(Permisos.ExpedienteAprobar))
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button class="nav-link @(pestana == 0 ? "active" : "")" @onclick="() => pestana = 0">Búsqueda</button></li>
            <li class="nav-item"><button class="nav-link @(pestana == 1 ? "active" : "")" @onclick="AbrirPendientes">Pendientes de aprobación @(pendientes.Count > 0 ? $"({pendientes.Count})" : "")</button></li>
        </ul>
    }

    <Alerta Mensaje="@error" Tipo="danger" />
    <Alerta Mensaje="@exito" Tipo="success" />

    @if (pestana == 0)
    {
        <div class="tarjeta p-3 mb-3">
            <div class="row g-3">
                <div class="col-12 col-lg-5">
                    <label class="form-label mb-1">Habilidades</label>
                    <input class="form-control form-control-sm mb-2" placeholder="Filtrar la lista…" @bind="textoCatalogo" @bind:event="oninput" />
                    <div class="border rounded p-2" style="max-height: 11rem; overflow-y: auto;">
                        @foreach (var h in CatalogoVisible)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="h-@h.HabilidadId" checked="@seleccion.Contains(h.HabilidadId)" @onchange="e => Alternar(h.HabilidadId, (bool)e.Value!)" />
                                <label class="form-check-label" for="h-@h.HabilidadId">@h.Nombre <span class="text-muted small">(@h.Trabajadores)</span></label>
                            </div>
                        }
                        @if (!CatalogoVisible.Any()) { <div class="text-muted small">No hay habilidades registradas.</div> }
                    </div>
                    <div class="form-check form-check-inline mt-2">
                        <input class="form-check-input" type="radio" name="modo" id="modoTodas" checked="@filtro.TodasLasHabilidades" @onchange="() => filtro.TodasLasHabilidades = true" />
                        <label class="form-check-label" for="modoTodas">Todas</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="modo" id="modoAlguna" checked="@(!filtro.TodasLasHabilidades)" @onchange="() => filtro.TodasLasHabilidades = false" />
                        <label class="form-check-label" for="modoAlguna">Alguna</label>
                    </div>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="row g-2">
                        <div class="col-6 col-md-4">
                            <label class="form-label mb-1" for="nivel">Nivel mínimo</label>
                            <select id="nivel" class="form-select" @bind="nivelMinimo">
                                <option value="">Cualquiera</option>
                                <option value="@NivelHabilidad.Basico">Básico</option>
                                <option value="@NivelHabilidad.Intermedio">Intermedio</option>
                                <option value="@NivelHabilidad.Avanzado">Avanzado</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label mb-1" for="tipoEst">Tipo de estudio</label>
                            <select id="tipoEst" class="form-select" @bind="tipoEstudio">
                                <option value="">Cualquiera</option>
                                @foreach (var t in TipoEstudio.Todos) { <option value="@t">@TipoEstudio.Nombre(t)</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1" for="textoEst">Título o institución</label>
                            <input id="textoEst" class="form-control" @bind="filtro.Estudio" @bind:event="oninput" @onkeydown="Tecla" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="soloActivos" @bind="filtro.SoloActivos" />
                                <label class="form-check-label" for="soloActivos">Solo trabajadores activos</label>
                            </div>
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-primary" @onclick="Buscar" disabled="@cargando">Buscar</button>
                            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (cargando) { <Cargando /> }
        else if (datos is not null)
        {
            <div class="tarjeta p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Trabajador</th><th class="d-none d-md-table-cell">Puesto</th><th>Habilidades</th><th class="d-none d-lg-table-cell">Estudios</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in datos.Items)
                            {
                                <tr>
                                    <td>
                                        @t.Nombres @t.Apellidos
                                        @if (!string.IsNullOrEmpty(t.Departamento)) { <div class="small text-muted">@t.Departamento</div> }
                                    </td>
                                    <td class="d-none d-md-table-cell">@(t.Puesto ?? "—")</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var h in t.Habilidades) { <span class="badge text-bg-light border">@h</span> }
                                            @if (t.Habilidades.Count == 0) { <span class="text-muted">—</span> }
                                        </div>
                                    </td>
                                    <td class="d-none d-lg-table-cell small">
                                        @foreach (var e in t.Estudios) { <div>@e</div> }
                                        @if (t.Estudios.Count == 0) { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" href="trabajadores/@t.TrabajadorId">Expediente</a></td>
                                </tr>
                            }
                            @if (datos.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Ningún trabajador cumple esos criterios.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
            <Paginador Page="datos.Page" PageSize="datos.PageSize" Total="datos.Total" OnPage="IrAPagina" />
        }
    }
    else
    {
        <div class="tarjeta p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Trabajador</th><th>Tipo</th><th>Propuesta</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var p in pendientes)
                        {
                            <tr>
                                <td><a href="trabajadores/@p.TrabajadorId">@p.TrabajadorNombre</a></td>
                                <td>@p.Clase</td>
                                <td>@p.Descripcion<div class="small text-muted">@Formato.Local(p.FechaCreacionUtc)</div></td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-success" @onclick="() => Aprobar(p)" disabled="@guardando">Aprobar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirRechazo(p)" disabled="@guardando">Rechazar</button>
                                </td>
                            </tr>
                        }
                        @if (pendientes.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">No hay propuestas pendientes.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    }
</SoloConPermiso>

<Modal @bind-Visible="rechazoVisible" Titulo="Rechazar propuesta" Tamano="modal-sm">
    <ChildContent>
        <label class="form-label">Motivo (se le muestra al trabajador)</label>
        <input class="form-control" maxlength="300" @bind="motivoRechazo" @bind:event="oninput" />
        <Alerta Mensaje="@errorForm" Tipo="danger" Clase="mt-3 mb-0" />
    </ChildContent>
    <Footer>
        <button class="btn btn-outline-secondary" @onclick="() => rechazoVisible = false">Cancelar</button>
        <button class="btn btn-danger" @onclick="ConfirmarRechazo" disabled="@(guardando || string.IsNullOrWhiteSpace(motivoRechazo))">Rechazar</button>
    </Footer>
</Modal>

@code {
    [CascadingParameter] private Task<AuthenticationState>? Estado { get; set; }

    private ClaimsPrincipal? user;
    private readonly PerfilFiltro filtro = new() { PageSize = 20 };
    private List<HabilidadDto> catalogo = new();
    private readonly HashSet<Guid> seleccion = new();
    private string? textoCatalogo, nivelMinimo, tipoEstudio;
    private PagedResult<PerfilResultadoDto>? datos;
    private List<PendienteExpedienteDto> pendientes = new();
    private PendienteExpedienteDto? rechazando;
    private string? motivoRechazo, error, exito, errorForm;
    private bool cargando, guardando, rechazoVisible;
    private int pestana;

    private IEnumerable<HabilidadDto> CatalogoVisible => string.IsNullOrWhiteSpace(textoCatalogo)
        ? catalogo : catalogo.Where(h => h.Nombre.Contains(textoCatalogo.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool Puede(string permiso) => user?.TienePermiso(permiso) == true;

    protected override async Task OnInitializedAsync()
    {
        user = Estado is null ? null : (await Estado).User;
        if (!Puede(Permisos.ExpedienteBuscar)) return;
        var c = await Api.HabilidadesAsync();
        if (c.Ok) catalogo = c.Data ?? new(); else error = c.Error;
        if (Puede(Permisos.ExpedienteAprobar)) await CargarPendientes();
        await Buscar();
    }

    private void Alternar(Guid id, bool marcado)
    {
        if (marcado) seleccion.Add(id); else seleccion.Remove(id);
    }

    private async Task Tecla(KeyboardEventArgs e) { if (e.Key == "Enter") await Buscar(); }

    private async Task Buscar() { filtro.Page = 1; await Cargar(); }

    private async Task IrAPagina(int p) { filtro.Page = p; await Cargar(); }

    private void Limpiar()
    {
        seleccion.Clear(); nivelMinimo = tipoEstudio = null; filtro.Estudio = null; filtro.TodasLasHabilidades = true; filtro.SoloActivos = true;
    }

    private async Task Cargar()
    {
        cargando = true; error = null;
        filtro.HabilidadIds = seleccion.ToList();
        filtro.NivelMinimo = byte.TryParse(nivelMinimo, out var n) ? n : null;
        filtro.TipoEstudio = byte.TryParse(tipoEstudio, out var t) ? t : null;
        var r = await Api.BuscarAsync(filtro);
        if (r.Ok) datos = r.Data; else error = r.Error;
        cargando = false;
    }

    private async Task AbrirPendientes() { pestana = 1; await CargarPendientes(); }

    private async Task CargarPendientes()
    {
        var r = await Api.PendientesAsync();
        if (r.Ok) pendientes = r.Data ?? new(); else error = r.Error;
    }

    private async Task Aprobar(PendienteExpedienteDto p)
    {
        error = exito = null; guardando = true;
        try
        {
            var r = await Api.ResolverAsync(p, true, null);
            if (!r.Ok) { error = r.Error; return; }
            exito = "Propuesta aprobada.";
            await CargarPendientes();
        }
        finally { guardando = false; }
    }

    private void PedirRechazo(PendienteExpedienteDto p) { rechazando = p; motivoRechazo = null; errorForm = null; rechazoVisible = true; }

    private async Task ConfirmarRechazo()
    {
        if (rechazando is null) return;
        errorForm = null; guardando = true;
        try
        {
            var r = await Api.ResolverAsync(rechazando, false, motivoRechazo);
            if (!r.Ok) { errorForm = r.Error; return; }
            rechazoVisible = false;
            exito = "Propuesta rechazada.";
            await CargarPendientes();
        }
        finally { guardando = false; }
    }
}
