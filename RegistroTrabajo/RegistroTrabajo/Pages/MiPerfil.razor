@page "/cuenta/perfil"
@attribute [Authorize]

<PageTitle>Mi perfil - Registro de Trabajo</PageTitle>

<h1 class="h3 mb-3">Mi perfil</h1>

<Alerta Mensaje="@error" Tipo="danger" />
<Alerta Mensaje="@exito" Tipo="success" />

@if (cargando) { <Cargando /> }
else if (yo is null)
{
    <div class="alert alert-info">Tu cuenta no está vinculada a un expediente de trabajador.</div>
}
else
{
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="tarjeta p-3 h-100">
                <h2 class="h5">@yo.Nombres @yo.Apellidos</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-5">Departamento</dt><dd class="col-sm-7">@(yo.Departamento ?? "—")</dd>
                    <dt class="col-sm-5">Puesto</dt><dd class="col-sm-7">@(yo.Puesto ?? "—")</dd>
                    <dt class="col-sm-5">Supervisores</dt><dd class="col-sm-7">@(yo.Supervisores.Count == 0 ? "—" : string.Join(", ", yo.Supervisores))</dd>
                    <dt class="col-sm-5">Correo de contacto</dt><dd class="col-sm-7">@(yo.CorreoContacto ?? "—")</dd>
                    <dt class="col-sm-5">Teléfono</dt><dd class="col-sm-7">@(yo.Telefono ?? "—")</dd>
                    <dt class="col-sm-5">Dirección</dt><dd class="col-sm-7">@(yo.Direccion ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="tarjeta p-3 h-100">
                <h2 class="h5">Solicitar un cambio</h2>
                <p class="small text-muted">Los cambios no se aplican a tu expediente hasta que sean aprobados.</p>
                @if (pendiente)
                {
                    <div class="alert alert-warning mb-0">Ya tienes una solicitud pendiente de revisión.</div>
                }
                else
                {
                    <EditForm Model="form" OnValidSubmit="Solicitar">
                        <DataAnnotationsValidator />
                        <div class="mb-2"><label class="form-label">Correo de contacto</label><InputText type="email" class="form-control" @bind-Value="form.CorreoContacto" /><ValidationMessage For="() => form.CorreoContacto" /></div>
                        <div class="mb-2"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="form.Telefono" /></div>
                        <div class="mb-3"><label class="form-label">Dirección</label><InputText class="form-control" @bind-Value="form.Direccion" /></div>
                        <button class="btn btn-primary" type="submit" disabled="@guardando">Enviar solicitud</button>
                    </EditForm>
                }
            </div>
        </div>

        <div class="col-12">
            <div class="tarjeta p-3">
                <h2 class="h5">Mis solicitudes</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Fecha</th><th>Cambios</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in solicitudes)
                            {
                                <tr>
                                    <td>@Formato.Local(s.SolicitadaUtc)</td>
                                    <td class="small">
                                        @if (s.Datos.CorreoContacto is not null) { <div>Correo: @s.Datos.CorreoContacto</div> }
                                        @if (s.Datos.Telefono is not null) { <div>Teléfono: @s.Datos.Telefono</div> }
                                        @if (s.Datos.Direccion is not null) { <div>Dirección: @s.Datos.Direccion</div> }
                                    </td>
                                    <td>
                                        <span class="badge @FormatoLaboral.ClaseSolicitud(s.Estado)">@FormatoLaboral.EstadoSolicitud(s.Estado)</span>
                                        @if (!string.IsNullOrEmpty(s.ComentarioRevision)) { <div class="small text-muted">@s.ComentarioRevision</div> }
                                    </td>
                                    <td class="text-end">
                                        @if (s.Estado == EstadoSolicitudPerfil.Pendiente) { <button class="btn btn-sm btn-outline-secondary" @onclick="() => Cancelar(s)">Cancelar</button> }
                                    </td>
                                </tr>
                            }
                            @if (solicitudes.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-2">Aún no has enviado solicitudes.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private TrabajadoresClient Trabajadores { get; set; } = default!;
    [Inject] private SolicitudesPerfilClient Api { get; set; } = default!;

    private TrabajadorDetalleDto? yo;
    private List<SolicitudCambioPerfilDto> solicitudes = new();
    private CambioPerfilDatos form = new();
    private bool cargando = true, guardando;
    private string? error, exito;

    private bool pendiente => solicitudes.Any(s => s.Estado == EstadoSolicitudPerfil.Pendiente);

    protected override async Task OnInitializedAsync()
    {
        var r = await Trabajadores.MiExpedienteAsync();
        if (r.Ok) { yo = r.Data; await CargarSolicitudes(); }
        else if (r.Status != System.Net.HttpStatusCode.NotFound) error = r.Error;
        cargando = false;
    }

    private async Task CargarSolicitudes()
    {
        var s = await Api.MiasAsync();
        if (s.Ok) solicitudes = s.Data ?? new(); else error = s.Error;
    }

    private async Task Solicitar()
    {
        error = exito = null;
        guardando = true;
        try
        {
            var r = await Api.CrearAsync(form);
            if (!r.Ok) { error = r.Error; return; }
            form = new();
            exito = "Solicitud enviada. Se aplicará cuando sea aprobada.";
            await CargarSolicitudes();
        }
        finally { guardando = false; }
    }

    private async Task Cancelar(SolicitudCambioPerfilDto s)
    {
        error = exito = null;
        var r = await Api.CancelarAsync(s.SolicitudCambioPerfilId);
        if (!r.Ok) { error = r.Error; return; }
        exito = "Solicitud cancelada.";
        await CargarSolicitudes();
    }
}
