@page "/auditoria"
@attribute [Authorize]
@inject RegistrosClient Api

<PageTitle>Auditoría - Registro de Trabajo</PageTitle>

<SoloConPermiso Codigo="@Permisos.AuditoriaConsultar">
    <h1 class="h3 mb-3">Auditoría</h1>
    <div class="tarjeta p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label mb-1" for="desde">Desde</label>
                <input id="desde" type="date" class="form-control" @bind="desde" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1" for="hasta">Hasta</label>
                <input id="hasta" type="date" class="form-control" @bind="hasta" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1" for="entidad">Entidad</label>
                <select id="entidad" class="form-select" @bind="filtro.Entidad">
                    <option value="">Todas</option>
                    @foreach (var e in Entidades) { <option value="@e">@e</option> }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <button class="btn btn-outline-primary w-100" @onclick="Buscar">Filtrar</button>
            </div>
        </div>
    </div>
    <Alerta Mensaje="@error" Tipo="danger" />
    @if (cargando) { <Cargando /> }
    else if (datos is not null)
    {
        <div class="tarjeta p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Fecha</th><th>Módulo</th><th>Entidad</th><th>Acción</th><th class="d-none d-lg-table-cell">IP</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in datos.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@Formato.Local(a.FechaUtc)</td>
                                <td>@a.Modulo</td>
                                <td>@a.Entidad</td>
                                <td><span class="badge text-bg-primary">@a.Accion</span></td>
                                <td class="d-none d-lg-table-cell">@a.DireccionIp</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-secondary" @onclick="() => Ver(a)">Detalle</button></td>
                            </tr>
                        }
                        @if (datos.Items.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Sin registros con esos criterios.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
        <Paginador Page="datos.Page" PageSize="datos.PageSize" Total="datos.Total" OnPage="IrAPagina" />
    }
</SoloConPermiso>

<Modal @bind-Visible="detalleVisible" Titulo="Detalle de la operación" Tamano="modal-lg">
    @if (detalle is not null)
    {
        <dl class="row mb-3">
            <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Formato.Local(detalle.FechaUtc)</dd>
            <dt class="col-sm-3">Operación</dt><dd class="col-sm-9">@detalle.Modulo · @detalle.Entidad · @detalle.Accion</dd>
            <dt class="col-sm-3">Registro</dt><dd class="col-sm-9"><code>@detalle.EntidadId</code></dd>
            <dt class="col-sm-3">Usuario</dt><dd class="col-sm-9"><code>@detalle.UsuarioId</code></dd>
            <dt class="col-sm-3">IP</dt><dd class="col-sm-9">@detalle.DireccionIp</dd>
            <dt class="col-sm-3">Correlación</dt><dd class="col-sm-9"><code>@detalle.CorrelationId</code></dd>
        </dl>
        <div class="row g-3">
            <div class="col-md-6"><div class="fw-semibold mb-1">Antes</div><pre class="bg-light p-2 small rounded">@Formato.Json(detalle.DatosAntesJson)</pre></div>
            <div class="col-md-6"><div class="fw-semibold mb-1">Después</div><pre class="bg-light p-2 small rounded">@Formato.Json(detalle.DatosDespuesJson)</pre></div>
        </div>
    }
</Modal>

@code {
    [CascadingParameter] private Task<AuthenticationState>? Estado { get; set; }
    private static readonly string[] Entidades =
        { "Empresa", "ConfiguracionEmpresa", "Usuario", "Rol", "RolPermiso", "UsuarioRol", "SesionUsuario" };

    private readonly AuditoriaFiltro filtro = new() { PageSize = 20 };
    private PagedResult<AuditoriaDto>? datos;
    private DateTime? desde, hasta;
    private bool cargando = true, detalleVisible;
    private string? error;
    private AuditoriaDto? detalle;

    protected override async Task OnInitializedAsync()
    {
        var user = Estado is null ? null : (await Estado).User;
        if (user?.TienePermiso(Permisos.AuditoriaConsultar) == true) await Cargar(); else cargando = false;
    }

    private async Task Buscar() { filtro.Page = 1; await Cargar(); }
    private async Task IrAPagina(int p) { filtro.Page = p; await Cargar(); }
    private void Ver(AuditoriaDto a) { detalle = a; detalleVisible = true; }

    private async Task Cargar()
    {
        cargando = true;
        error = null;
        filtro.Desde = desde is { } d ? DateTime.SpecifyKind(d.Date, DateTimeKind.Local).ToUniversalTime() : null;
        filtro.Hasta = hasta is { } h ? DateTime.SpecifyKind(h.Date.AddDays(1).AddSeconds(-1), DateTimeKind.Local).ToUniversalTime() : null;
        var r = await Api.AuditoriaAsync(filtro);
        if (r.Ok) datos = r.Data; else error = r.Error;
        cargando = false;
    }
}