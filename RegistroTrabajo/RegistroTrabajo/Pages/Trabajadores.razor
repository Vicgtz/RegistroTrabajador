@page "/trabajadores"
@attribute [Authorize]

<PageTitle>Trabajadores - Registro de Trabajo</PageTitle>

<SoloConPermiso Codigo="@Permisos.TrabajadoresConsultar">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">Trabajadores</h1>
        @if (Puede(Permisos.TrabajadoresCrear))
        {
            <button class="btn btn-primary" @onclick="Nuevo">Nuevo trabajador</button>
        }
    </div>

    <div class="tarjeta p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label mb-1" for="buscar">Buscar</label>
                <input id="buscar" class="form-control" placeholder="Nombre o número de empleado" @bind="filtro.Buscar" @bind:event="oninput" @onkeydown="TeclaBuscar" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label mb-1" for="depto">Departamento</label>
                <select id="depto" class="form-select" @bind="filtro.DepartamentoId">
                    <option value="">Todos</option>
                    @foreach (var d in departamentos) { <option value="@d.Id">@d.Nombre@(d.Estado ? "" : " (inactivo)")</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label mb-1" for="puesto">Puesto</label>
                <select id="puesto" class="form-select" @bind="filtro.PuestoId">
                    <option value="">Todos</option>
                    @foreach (var p in puestos) { <option value="@p.Id">@p.Nombre@(p.Estado ? "" : " (inactivo)")</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label mb-1" for="estado">Estado laboral</label>
                <select id="estado" class="form-select" @bind="filtro.EstadoLaboral">
                    <option value="">Todos</option>
                    <option value="@EstadoLaboral.Activo">Activos</option>
                    <option value="@EstadoLaboral.Inactivo">Inactivos</option>
                    <option value="@EstadoLaboral.Baja">Baja</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button class="btn btn-outline-primary w-100" @onclick="Buscar">Buscar</button>
            </div>
        </div>
    </div>

    <Alerta Mensaje="@error" Tipo="danger" />

    @if (cargando)
    {
        <Cargando />
    }
    else if (datos is not null)
    {
        <div class="tarjeta p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Trabajador</th><th class="d-none d-md-table-cell">Departamento</th><th class="d-none d-md-table-cell">Puesto</th>
                            <th class="d-none d-lg-table-cell">Supervisores</th><th>Estado</th><th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in datos.Items)
                        {
                            <tr>
                                <td>
                                    @t.Nombres @t.Apellidos
                                    @if (!string.IsNullOrEmpty(t.NumeroEmpleado)) { <div class="small text-muted">N.º @t.NumeroEmpleado</div> }
                                </td>
                                <td class="d-none d-md-table-cell">@(t.Departamento ?? "—")</td>
                                <td class="d-none d-md-table-cell">@(t.Puesto ?? "—")</td>
                                <td class="d-none d-lg-table-cell">@(t.Supervisores.Count == 0 ? "—" : string.Join(", ", t.Supervisores))</td>
                                <td><span class="badge @FormatoLaboral.ClaseEstado(t.EstadoLaboral)">@FormatoLaboral.Estado(t.EstadoLaboral)</span></td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" href="trabajadores/@t.TrabajadorId">Expediente</a>
                                </td>
                            </tr>
                        }
                        @if (datos.Items.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No hay trabajadores con esos criterios.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <Paginador Page="datos.Page" PageSize="datos.PageSize" Total="datos.Total" OnPage="IrAPagina" />
    }
</SoloConPermiso>

<Modal @bind-Visible="formVisible" Titulo="Nuevo trabajador" Tamano="modal-lg">
    <ChildContent>
        <EditForm Model="form" OnValidSubmit="Guardar" id="formTrabajador">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombres</label>
                    <InputText class="form-control" @bind-Value="form.Nombres" />
                    <ValidationMessage For="() => form.Nombres" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellidos</label>
                    <InputText class="form-control" @bind-Value="form.Apellidos" />
                    <ValidationMessage For="() => form.Apellidos" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Número de empleado</label>
                    <InputText class="form-control" @bind-Value="form.NumeroEmpleado" />
                    <ValidationMessage For="() => form.NumeroEmpleado" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha de ingreso</label>
                    <InputDate class="form-control" @bind-Value="form.FechaIngreso" />
                    <ValidationMessage For="() => form.FechaIngreso" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="form.Telefono" />
                    <ValidationMessage For="() => form.Telefono" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Correo de contacto</label>
                    <InputText type="email" class="form-control" @bind-Value="form.CorreoContacto" />
                    <ValidationMessage For="() => form.CorreoContacto" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha de nacimiento</label>
                    <InputDate class="form-control" @bind-Value="form.FechaNacimiento" />
                    <ValidationMessage For="() => form.FechaNacimiento" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Departamento</label>
                    <select class="form-select" @bind="form.DepartamentoId">
                        <option value="">Sin departamento</option>
                        @foreach (var d in departamentos.Where(x => x.Estado)) { <option value="@d.Id">@d.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Puesto</label>
                    <select class="form-select" @bind="form.PuestoId">
                        <option value="">Sin puesto</option>
                        @foreach (var p in puestos.Where(x => x.Estado)) { <option value="@p.Id">@p.Nombre</option> }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control" @bind-Value="form.Direccion" />
                    <ValidationMessage For="() => form.Direccion" />
                </div>
            </div>
            <Alerta Mensaje="@errorForm" Tipo="danger" Clase="mt-3 mb-0" />
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-outline-secondary" @onclick="() => formVisible = false">Cancelar</button>
        <button class="btn btn-primary" type="submit" form="formTrabajador" disabled="@guardando">Guardar</button>
    </Footer>
</Modal>
