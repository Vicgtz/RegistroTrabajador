            var r = await Api.CrearFestivoAsync(festivo);
            if (!r.Ok) { errorForm = r.Error; return; }
            festivoVisible = false; exito = "Festivo guardado."; await Cargar();
        }
        finally { guardando = false; }
    }

    private async Task EliminarFestivo(DiaFestivoDto f) => await Resultado(await Api.EliminarFestivoAsync(f.DiaFestivoId), "Festivo eliminado.");
