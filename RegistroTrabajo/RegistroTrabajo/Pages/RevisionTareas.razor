@page "/revision-tareas"
@attribute [Authorize]
@using System.Security.Claims

<PageTitle>Revisión de tareas - Registro de Trabajo</PageTitle>

@if (user is not null && !Puede(Permisos.TareasRevisar))
{
    <div class="tarjeta p-4 text-center">
        <h1 class="h5">Sin permiso</h1>
        <p class="text-muted mb-0">Tu cuenta no tiene autorización para revisar tareas.</p>
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0">Revisión de tareas</h1>
            <div class="small text-muted">Trabajos terminados que esperan validación</div>
        </div>
        <a class="btn btn-outline-secondary" href="seguimiento">Panel de seguimiento</a>
    </div>

    <Alerta Mensaje="@error" Tipo="danger" />
    <Alerta Mensaje="@exito" Tipo="success" />

    @if (cargando) { <Cargando /> }
    else if (tareas is not null)
    {
        @if (tareas.Count == 0)
        {
            <div class="tarjeta p-4 text-center text-muted">No hay tareas pendientes de revisión.</div>
        }
        else
        {
            <div class="tarjeta p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Tarea</th><th>Proyecto</th><th>Asignados</th><th>Enviada</th><th>Fecha límite</th><th class="text-end">Acciones</th></tr></thead>
                        <tbody>
                            @foreach (var t in tareas)
                            {
                                <tr>
                                    <td><a class="fw-semibold text-decoration-none" href="tareas/@t.TareaId">@t.Titulo</a></td>
                                    <td><a class="text-decoration-none" href="proyectos/@t.ProyectoId">@t.Proyecto</a></td>
                                    <td class="small">@(t.Asignados.Count == 0 ? "—" : string.Join(", ", t.Asignados))</td>
                                    <td class="small">@FormatoProyectos.FechaHora(t.UltimaActualizacionUtc)</td>
                                    <td class="@(t.Vencida ? "text-danger fw-semibold" : "")">@FormatoProyectos.Fecha(t.FechaVencimiento)@(t.Vencida ? " (vencida)" : "")</td>
                                    <td class="text-end text-nowrap">
                                        @if (t.PuedeRevisar)
                                        {
                                            <button class="btn btn-sm btn-success" disabled="@guardando" @onclick="() => Abrir(t, true)">Aprobar</button>
                                            <button class="btn btn-sm btn-outline-danger" disabled="@guardando" @onclick="() => Abrir(t, false)">Solicitar correcciones</button>
                                        }
                                        else { <span class="small text-muted">Solo lectura</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

<Modal @bind-Visible="visible" Titulo="@(aprobar ? "Aprobar tarea" : "Solicitar correcciones")">
    <ChildContent>
        <Alerta Mensaje="@errorForm" Tipo="danger" />
        <p class="small text-muted">@(seleccionada?.Titulo)</p>
        <label class="form-label" for="rObs">@(aprobar ? "Observaciones (opcional)" : "¿Qué debe corregirse?")</label>
        <textarea id="rObs" class="form-control" rows="3" maxlength="2000" @bind="observacion"></textarea>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="() => visible = false">Volver</button>
        <button class="btn @(aprobar ? "btn-success" : "btn-danger")" disabled="@guardando" @onclick="Confirmar">@(aprobar ? "Aprobar" : "Devolver")</button>
    </Footer>
</Modal>

@code {
    [Inject] private SeguimientoClient Api { get; set; } = default!;
    [Inject] private TareasClient TareasApi { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? Sesion { get; set; }

    private ClaimsPrincipal? user;
    private List<TareaSeguimientoDto>? tareas;
    private TareaSeguimientoDto? seleccionada;
    private string? observacion, error, exito, errorForm;
    private bool cargando = true, guardando, visible, aprobar;

    protected override async Task OnInitializedAsync()
    {
        user = Sesion is null ? null : (await Sesion).User;
        if (Puede(Permisos.TareasRevisar)) await Cargar();
        cargando = false;
    }

    private bool Puede(string permiso) => user?.TienePermiso(permiso) == true;

    private async Task Cargar()
    {
        var r = await Api.PendientesRevisionAsync(new SeguimientoFiltro());
        if (r.Ok) tareas = r.Data ?? new(); else error = r.Error;
    }

    private void Abrir(TareaSeguimientoDto t, bool aprobada) { seleccionada = t; aprobar = aprobada; observacion = null; errorForm = null; visible = true; }

    private async Task Confirmar()
    {
        if (seleccionada is null) return;
        errorForm = error = exito = null; guardando = true;
        try
        {
            var r = await TareasApi.RevisarAsync(seleccionada.TareaId, new RevisarTareaRequest { Aprobar = aprobar, Comentario = observacion, RowVersion = seleccionada.RowVersion });
            if (!r.Ok) { errorForm = r.Error; return; }
            visible = false;
            exito = aprobar ? $"«{seleccionada.Titulo}» fue aprobada." : $"«{seleccionada.Titulo}» fue devuelta con observaciones.";
            await Cargar();
        }
        finally { guardando = false; }
    }
}
