@page "/"
@attribute [Authorize]

<PageTitle>Inicio - Registro de Trabajo</PageTitle>

@if (perfil is null)
{
    <div class="text-center py-5 text-muted">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Cargando...
    </div>
}
else
{
    <div class="bienvenida mb-4">
        <h1 class="h3 mb-1">Hola, @perfil.Nombre</h1>
        <p class="text-muted mb-2">@perfil.EmpresaNombre · @perfil.Correo</p>
        @foreach (var rol in perfil.Roles)
        {
            <span class="badge rounded-pill text-bg-primary me-1">@rol</span>
        }
        @if (perfil.Roles.Count == 0)
        {
            <span class="badge rounded-pill text-bg-secondary">Sin rol asignado</span>
        }
    </div>

    <Alerta Mensaje="@errorDashboard" Tipo="warning" />
    @if (dashboard is not null)
    {
        <div class="small text-muted mb-2">Panel de @dashboard.Perfil · @(dashboard.Ambito switch { "empresa" => "información de toda la empresa", "equipo" => "información de tu equipo", _ => "tu información personal" })</div>
        <div class="row g-3 mb-3">
            @if (dashboard.Trabajadores is { } tr)
            {
                <div class="col-6 col-lg-3">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">Trabajadores activos</div>
                        <div class="indicador-valor">@tr.Activos</div>
                        <div class="indicador-nota">@tr.Inactivos inactivos · @tr.Baja de baja · @tr.AltasUltimos30Dias altas en 30 días</div>
                    </div>
                </div>
            }
            @if (dashboard.Permisos is { } pe)
            {
                <div class="col-6 col-lg-3">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">@(pe.PendientesPorRevisar is null ? "Mis permisos pendientes" : "Permisos por revisar")</div>
                        <div class="indicador-valor">@(pe.PendientesPorRevisar ?? pe.MisPendientes)</div>
                        <div class="indicador-nota">
                            @if (pe.PendientesPorRevisar is not null) { <text>@pe.MisPendientes propios pendientes · </text> }
                            @pe.ProximosAprobados aprobados por comenzar (14 días)
                        </div>
                        @if (pe.PendientesPorRevisar is not null) { <a class="small" href="permisos/aprobaciones">Ir a aprobaciones</a> }
                    </div>
                </div>
            }
            @if (dashboard.Asistencia is { } asi)
            {
                <div class="col-6 col-lg-3">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">@(dashboard.Ambito == "propio" ? "Asistencia de hoy" : "Con asistencia hoy")</div>
                        <div class="indicador-valor">@asi.ConRegistroHoy</div>
                        <div class="indicador-nota">@asi.IncompletasAnteriores jornadas anteriores sin salida</div>
                    </div>
                </div>
            }
            <div class="col-6 col-lg-3">
                <div class="tarjeta p-3 h-100">
                    <div class="dato-etiqueta">Notificaciones sin leer</div>
                    <div class="indicador-valor">@dashboard.NotificacionesNoLeidas</div>
                    <div class="indicador-nota">@dashboard.NotificacionesPrioritarias prioritarias</div>
                    <a class="small" href="notificaciones">Abrir centro</a>
                </div>
            </div>
            @if (dashboard.UsuariosActivos is { } ua)
            {
                <div class="col-6 col-lg-3">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">Usuarios activos</div>
                        <div class="indicador-valor">@ua</div>
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mb-3">
            @if (dashboard.Tareas is { } ta)
            {
                <div class="col-12 col-lg-7">
                    <div class="tarjeta p-3 h-100">
                        <h2 class="h6">@(dashboard.Ambito == "propio" ? "Mis tareas" : "Tareas de los proyectos")</h2>
                        <BarraApilada Segmentos="@(new SegmentoGrafica[] {
                            new("Pendientes", ta.Pendientes, "#7a8aa0"), new("En proceso", ta.EnProceso, "#2f6fb2"), new("En revisión", ta.EnRevision, "#e0a030"),
                            new("Reabiertas", ta.Reabiertas, "#c0392b"), new("Completadas", ta.Completadas, "#2e9e6b") })" />
                        <div class="mt-3 d-flex flex-wrap gap-3 small">
                            <span><strong class="@(ta.Vencidas > 0 ? "text-danger" : "")">@ta.Vencidas</strong> vencidas</span>
                            <span><strong>@ta.ProximasAVencer</strong> próximas a vencer</span>
                            <a href="seguimiento">Ver seguimiento</a>
                        </div>
                    </div>
                </div>
            }
            @if (dashboard.Proyectos is { } pr)
            {
                <div class="col-12 col-lg-5">
                    <div class="tarjeta p-3 h-100">
                        <h2 class="h6">Proyectos</h2>
                        <Dona Segmentos="@(new SegmentoGrafica[] { new("Activos", pr.Activos, "#2f6fb2"), new("Pausados", pr.Pausados, "#e0a030"), new("Finalizados", pr.Finalizados, "#2e9e6b") })" />
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-7">
                <div class="tarjeta p-3 h-100">
                    <h2 class="h6">Actividad reciente</h2>
                    @if (dashboard.Actividad.Count == 0) { <div class="text-muted small">Sin actividad reciente.</div> }
                    else
                    {
                        <ul class="list-unstyled small mb-0">
                            @foreach (var a in dashboard.Actividad)
                            {
                                <li class="py-1 border-bottom d-flex justify-content-between gap-2">
                                    <span>@if (a.Ruta is not null) { <a class="text-decoration-none" href="@a.Ruta">@a.Texto</a> } else { @a.Texto }</span>
                                    <span class="text-muted text-nowrap">@Local(a.FechaUtc)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="tarjeta p-3 h-100">
                    <h2 class="h6">Accesos rápidos</h2>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var a in dashboard.Accesos)
                        {
                            <a class="btn btn-sm btn-outline-primary acceso-rapido" href="@a.Ruta">@a.Titulo</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Cargando resumen...</div>
    }
    else if (resumen is not null)
    {
        <div class="row g-3 mb-4">
            @if (resumen.Empresa is not null)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">Empresa</div>
                        <div class="dato-valor">@(resumen.Empresa.NombreComercial ?? resumen.Empresa.Nombre)</div>
                        <span class="badge @(resumen.Empresa.Estado == EstadoEmpresa.Activa ? "text-bg-success" : "text-bg-warning")">@TextoEstadoEmpresa(resumen.Empresa.Estado)</span>
                    </div>
                </div>
            }
            @if (resumen.UsuariosTotal is not null)
            {
                <div class="col-6 col-md-3 col-xl-4">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">Usuarios</div>
                        <div class="dato-valor">@resumen.UsuariosTotal</div>
                    </div>
                </div>
            }
            @if (resumen.SesionesActivas is not null)
            {
                <div class="col-6 col-md-3 col-xl-4">
                    <div class="tarjeta p-3 h-100">
                        <div class="dato-etiqueta">Sesiones activas</div>
                        <div class="dato-valor">@resumen.SesionesActivas</div>
                    </div>
                </div>
            }
        </div>

        @if (resumen.AccesosRecientes is { Count: > 0 })
        {
            <div class="tarjeta p-3">
                <h2 class="h6 mb-3">Accesos recientes</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>Fecha</th><th>Correo</th><th>Resultado</th><th class="d-none d-md-table-cell">IP</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in resumen.AccesosRecientes)
                            {
                                <tr>
                                    <td class="text-nowrap">@Local(a.FechaUtc)</td>
                                    <td>@a.CorreoIntentado</td>
                                    <td><span class="badge @(a.Resultado == ResultadoAcceso.Exitoso ? "text-bg-success" : "text-bg-danger")">@TextoResultado(a.Resultado)</span></td>
                                    <td class="d-none d-md-table-cell">@a.DireccionIp</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorResumen))
        {
            <div class="alert alert-warning mt-3 py-2" role="alert">@errorResumen</div>
        }
    }
}
