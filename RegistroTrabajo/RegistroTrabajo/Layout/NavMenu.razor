                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accesos">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 7 9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5Zm9 12h-8v2h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-8v2h8v14Z" /></svg> Accesos
                    </NavLink>
