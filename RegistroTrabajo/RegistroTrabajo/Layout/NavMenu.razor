                    <NavLink class="nav-link" href="sesiones">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v10H4V6Zm-2 12h20v2H2v-2Z" /></svg> Sesiones
                    </NavLink>
                </div>
            }
            @if (context.User.TienePermiso(Permisos.AccesosConsultar))
