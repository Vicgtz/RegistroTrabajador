<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            @if (Tema.LogoDataUrl is not null)
            {
                <img src="@Tema.LogoDataUrl" alt="Logotipo" style="height:1.9rem;max-width:2.8rem;object-fit:contain;margin-right:.5rem;background:#fff;border-radius:.25rem;padding:2px" />
            }
            else
            {
                <svg class="marca" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6a1 1 0 0 1 1 1v2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3V5a1 1 0 0 1 1-1Zm1 3h4V6h-4v1Z" /></svg>
            }
            <span>@(Tema.Apariencia?.Nombre ?? "Registro de Trabajo")</span>
        </a>
        <button title="Menú de navegación" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
