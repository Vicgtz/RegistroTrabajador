                </NavLink>
            </div>

            @if (context.User.TienePermiso(Permisos.UsuariosConsultar))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="usuarios">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm8 2c-2.7 0-8 1.3-8 4v3h16v-3c0-2.7-5.3-4-8-4ZM8 13c-.3 0-.7 0-1.1.1C8.2 13.9 9 15 9 16.5V20H0v-3c0-2.2 4.4-4 8-4Z" /></svg> Usuarios
