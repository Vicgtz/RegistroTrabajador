                    </NavLink>
                </div>
            }

            <div class="nav-section px-3">Mi cuenta</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="cuenta/sesiones">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 1H7a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm0 18H7V5h10v14Z" /></svg> Mis sesiones
                </NavLink>
