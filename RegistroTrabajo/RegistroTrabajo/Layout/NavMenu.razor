                    <NavLink class="nav-link" href="roles">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4Zm-1 15-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6Z" /></svg> Roles y permisos
                    </NavLink>
                </div>
            }
            @if (context.User.TienePermiso(Permisos.EmpresaConsultar))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="empresa">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V3h12v6h6v12H3Zm4-4h2v-2H7v2Zm0-4h2v-2H7v2Zm0-4h2V7H7v2Zm4 8h2v-2h-2v2Zm0-4h2v-2h-2v2Zm0-4h2V7h-2v2Zm6 8h2v-2h-2v2Zm0-4h2v-2h-2v2Z" /></svg> Mi empresa
