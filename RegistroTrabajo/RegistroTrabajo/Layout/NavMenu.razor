                </NavLink>
            </div>

            @if (context.User.TienePermiso(Permisos.CalendarioConsultar))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calendario" Match="NavLinkMatch.All">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 16H5V10h14v10ZM7 12h4v4H7v-4Z" /></svg> Calendario
                    </NavLink>
                </div>
            }
            @if (context.User.TienePermiso(Permisos.ProyectosConsultar))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="proyectos">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2Z" /></svg> Proyectos
