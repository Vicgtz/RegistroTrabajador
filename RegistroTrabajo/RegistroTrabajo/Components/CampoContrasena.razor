@using System.Diagnostics.CodeAnalysis
@inherits InputBase<string>

@* Campo de contraseña con botón para verla u ocultarla. Se usa igual que InputText (@bind-Value, ValidationMessage, id, autocomplete…). *@
<div class="input-group">
    <input @attributes="AdditionalAttributes" type="@(ver ? "text" : "password")" class="@CssClass" @bind="CurrentValueAsString" @bind:event="oninput" />
    <button type="button" class="btn btn-outline-secondary" @onclick="() => ver = !ver" aria-pressed="@(ver ? "true" : "false")" title="@(ver ? "Ocultar contraseña" : "Ver contraseña")"
            aria-label="@(ver ? "Ocultar contraseña" : "Ver contraseña")" disabled="@(AdditionalAttributes?.ContainsKey("disabled") == true && AdditionalAttributes["disabled"] is true)"><IconoOjo Tachado="ver" /></button>
</div>

@code {
    private bool ver;

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? "";
        validationErrorMessage = null;
        return true;
    }
}
