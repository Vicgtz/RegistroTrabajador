<Alerta Mensaje="@error" Tipo="danger" />

@if (cargando) { <Cargando /> }
else if (panel is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="small text-muted">@(panel.VerEquipo ? "Retrasos y pendientes de los proyectos que ves" : "Retrasos y pendientes de tus tareas")</div>
        @if (puedeRevisar) { <a class="btn btn-outline-primary" href="revision-tareas">Revisión de tareas</a> }
    </div>

    <div class="row g-3 mb-3">
        @Contador("Vencidas", panel.TotalVencidas, "danger", $"Fecha límite ya pasada")
        @Contador("Próximas a vencer", panel.TotalProximasAVencer, "warning", $"En {panel.DiasAlertaVencimiento} días hábiles o menos")
        @Contador("Pendientes de revisión", panel.TotalPendientesRevision, "primary", "Esperan validación")
        @Contador("Reabiertas", panel.TotalReabiertas, "secondary", "Con correcciones por hacer")
        @if (panel.DiasSinActualizacion is { } dsa) { @Contador("Sin actualización", panel.TotalSinActualizacion, "dark", $"{dsa} días hábiles o más") }
    </div>

    <div class="small text-muted mb-3">Los días hábiles descuentan sábados, domingos y festivos de la empresa. Una tarea vencida no cambia de estado: solo se marca.</div>

    @Lista("Vencidas", panel.Vencidas, panel.TotalVencidas, "text-danger", t => t.DiasRetraso is { } d ? $"{d} día(s) hábil(es) de retraso" : "")
    @Lista("Próximas a vencer", panel.ProximasAVencer, panel.TotalProximasAVencer, "", t => t.DiasParaVencer is { } d ? (d == 0 ? "Vence hoy" : $"Faltan {d} día(s) hábil(es)") : "")
    @Lista("Pendientes de revisión", panel.PendientesRevision, panel.TotalPendientesRevision, "", t => $"Desde {FormatoProyectos.FechaHora(t.UltimaActualizacionUtc)}")
    @Lista("Reabiertas", panel.Reabiertas, panel.TotalReabiertas, "", t => $"Desde {FormatoProyectos.FechaHora(t.UltimaActualizacionUtc)}")
    @if (panel.DiasSinActualizacion is not null)
    {
        @Lista("Sin actualizaciones recientes", panel.SinActualizacion, panel.TotalSinActualizacion, "", t => $"{t.DiasHabilesSinActualizar} día(s) hábil(es) sin cambios")
    }

    @if (panel.TotalVencidas + panel.TotalProximasAVencer + panel.TotalPendientesRevision + panel.TotalReabiertas + panel.TotalSinActualizacion == 0)
    {
        <div class="tarjeta p-4 text-center text-muted">No hay tareas que requieran atención.</div>
    }
}

@code {
    [Inject] private SeguimientoClient Api { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? Sesion { get; set; }

    private PanelSeguimientoDto? panel;
    private bool cargando = true;
    private bool puedeRevisar;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var user = Sesion is null ? null : (await Sesion).User;
        puedeRevisar = user?.TienePermiso(Permisos.TareasRevisar) == true;
        var r = await Api.PanelAsync(new SeguimientoFiltro());
        if (r.Ok) panel = r.Data; else error = r.Error;
        cargando = false;
    }

    private RenderFragment Contador(string titulo, int total, string clase, string nota) => __builder =>
    {
        <div class="col-6 col-lg">
            <div class="tarjeta p-3 h-100 resumen-tarjeta">
                <div class="small text-muted">@titulo</div>
                <div class="display-6 fw-semibold text-@(total > 0 ? clase : "muted")">@total</div>
                <div class="small text-muted">@nota</div>
            </div>
        </div>
    };

    private RenderFragment Lista(string titulo, List<TareaSeguimientoDto> tareas, int total, string clase, Func<TareaSeguimientoDto, string> nota) => __builder =>
    {
        if (tareas.Count == 0) return;
        <div class="tarjeta p-3 mb-3">
            <h2 class="h6 @clase">@titulo <span class="badge text-bg-light border">@total</span></h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Tarea</th><th>Proyecto</th><th>Asignados</th><th>Estado</th><th>Fecha límite</th><th>Detalle</th></tr></thead>
                    <tbody>
                        @foreach (var t in tareas)
                        {
                            <tr>
                                <td><a class="fw-semibold text-decoration-none" href="tareas/@t.TareaId">@t.Titulo</a></td>
                                <td><a class="text-decoration-none" href="proyectos/@t.ProyectoId">@t.Proyecto</a></td>
                                <td class="small">@(t.Asignados.Count == 0 ? "—" : string.Join(", ", t.Asignados))</td>
                                <td><span class="badge text-bg-@FormatoProyectos.ClaseEstadoTarea(t.Estado)">@FormatoProyectos.EstadoDeTarea(t.Estado)</span> <span class="small text-muted">@FormatoProyectos.Pct(t.PorcentajeAvance)</span></td>
                                <td class="@(t.Vencida ? "text-danger fw-semibold" : "")">@FormatoProyectos.Fecha(t.FechaVencimiento)</td>
                                <td class="small text-muted">@nota(t)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (total > tareas.Count) { <div class="small text-muted mt-2">Se muestran @tareas.Count de @total.</div> }
        </div>
    };
}
