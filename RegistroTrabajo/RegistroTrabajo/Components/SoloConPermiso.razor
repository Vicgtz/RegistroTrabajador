@* Muestra el contenido solo si el usuario tiene el permiso. Es solo visual: la API valida cada solicitud. *@
@if (_tiene)
{
    @ChildContent
}
else if (_resuelto)
{
    <div class="tarjeta p-4 text-center">
        <h1 class="h5">Sin permiso</h1>
        <p class="text-muted mb-0">Tu cuenta no tiene autorización para ver esta sección.</p>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? Estado { get; set; }
    [Parameter, EditorRequired] public string Codigo { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _tiene, _resuelto;

    protected override async Task OnParametersSetAsync()
    {
        var estado = Estado is null ? null : await Estado;
        _tiene = estado?.User.TienePermiso(Codigo) == true;
        _resuelto = true;
    }
}